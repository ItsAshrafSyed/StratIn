# Repository-level devnet registry integration script only.
# Application environments live beside their owning app/package.

# Neon/Postgres connection used by scripts/devnet-registry-integration.ts.
DATABASE_URL=

# Optional signer-path override for the explicit devnet integration script.
# Leave unset to use the Solana CLI configured keypair path. Never place a
# signer file inside this repository or commit its contents.
STRATIN_REGISTRY_SIGNER_PATH=

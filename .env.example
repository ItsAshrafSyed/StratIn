# Neon/Postgres connection string used by Drizzle and integration scripts.
DATABASE_URL=

# Optional full server-side Solana RPC override used by the local Next proxy.
# If set, this wins over HELIUS_API_KEY.
SOLANA_RPC_URL=

# Preferred for the execution spike. Keep this server-side only.
HELIUS_API_KEY=
HELIUS_RPC_BASE_URL=https://mainnet.helius-rpc.com/

# Browser-visible local proxy route. Keep this relative for local Next.js dev.
NEXT_PUBLIC_SOLANA_RPC_PROXY_URL=/api/solana-rpc

# Browser-visible Solana RPC URL used by Solana Kit's RPC plugin only.
# Wallet connection itself does not require this, but future Kit RPC usage may.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Registry-only RPC configuration. Use devnet here for registry validation
# without moving tokenized-equity execution/Jupiter settings off mainnet.
REGISTRY_SOLANA_RPC_URL=https://api.devnet.solana.com
REGISTRY_NETWORK=devnet
REGISTRY_HELIUS_API_KEY=
REGISTRY_HELIUS_RPC_BASE_URL=https://devnet.helius-rpc.com/
NEXT_PUBLIC_REGISTRY_SOLANA_RPC_PROXY_URL=/api/registry-rpc
NEXT_PUBLIC_REGISTRY_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_REGISTRY_NETWORK=devnet

# Wallet Standard chain used by Solana Kit. Keep mainnet for normal execution;
# switch to solana:devnet only when explicitly running registry-devnet tests.
NEXT_PUBLIC_WALLET_CHAIN=solana:mainnet

# Jupiter platform API key used for authenticated Tokens API catalog review.
JUPITER_API_KEY=

# Jupiter Swap API base used by the execution provider.
NEXT_PUBLIC_JUPITER_SWAP_API_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_SWAP_API_BASE_URL=https://lite-api.jup.ag/swap/v1

# Cloudflare Worker API for strategies/investments.
NEXT_PUBLIC_STRATIN_API_URL=http://localhost:8788

# Fee configuration. Amounts are basis points and can be overridden per environment.
ENTRY_FEE_BPS=25
REBALANCE_FEE_BPS=10
PROTOCOL_FEE_SHARE_BPS=2000
PROTOCOL_TREASURY=stiFExnwsWbHxrB5CqCSBWMbLjgB8hVLURtUsyAr3RT

# Optional override for scripts/devnet-registry-integration.ts.
# If omitted, the script uses the Solana CLI configured keypair path.
STRATIN_REGISTRY_SIGNER_PATH=

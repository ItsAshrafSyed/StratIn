# Required server-side mainnet execution RPC. Use a private provider URL.
SOLANA_RPC_URL=

# Required server-side registry RPC. StratIn currently verifies the registry
# against devnet while token execution remains on mainnet.
REGISTRY_SOLANA_RPC_URL=https://api.devnet.solana.com

# Required deployed StratIn API Worker URL. Use localhost for local development.
NEXT_PUBLIC_STRATIN_API_URL=http://localhost:8788

# Optional browser-visible overrides. The application already uses these
# defaults, so production deployments do not need to define them.
# NEXT_PUBLIC_SOLANA_RPC_PROXY_URL=/api/solana-rpc
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# NEXT_PUBLIC_REGISTRY_SOLANA_RPC_PROXY_URL=/api/registry-rpc
# NEXT_PUBLIC_WALLET_CHAIN=solana:mainnet
# NEXT_PUBLIC_JUPITER_SWAP_API_BASE_URL=https://lite-api.jup.ag/swap/v1
